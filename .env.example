# --- Ứng dụng ---
NODE_ENV=development
PORT=5000

# --- Cơ sở dữ liệu MongoDB ---
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dms_ktx?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/dms_ktx
MONGODB_URI=mongodb://localhost:27017/dms_ktx

# ⚠️ src/scripts/seed.js XÓA SẠCH CSDL. Chỉ đặt true khi cả nhóm thống nhất seed lại cụm Atlas dùng chung
SEED_ALLOW_REMOTE=false

# --- Xác thực JWT & Bảo mật ---
# Sinh chuỗi ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- CORS & Địa chỉ Frontend ---
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Tài khoản nhận tiền VietQR động (chuẩn NAPAS 247) ---
# Bỏ trống sẽ dùng thông tin mẫu (Vietcombank 970436) khi chạy thử
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

# --- Cấu hình Email SMTP (Gửi tài khoản tự động & kết quả duyệt đơn) ---
# Nếu bỏ trống SMTP_USER / SMTP_PASS, hệ thống tự động bỏ qua gửi email thật và ghi log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Ký túc xá Đại học Công nghiệp Hà Nội (HaUI - DMS)
