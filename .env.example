# --- App ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dms_ktx?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/dms_ktx
MONGODB_URI=mongodb://localhost:27017/dms_ktx

# --- Auth ---
# Sinh chuỗi bí mật bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Security ---
CORS_ORIGIN=http://localhost:5173

# --- Redis Cache (Tùy chọn - nếu không có sẽ tự fallback sang In-Memory) ---
ENABLE_REDIS=true
REDIS_URI=redis://127.0.0.1:6379

# --- VietQR: tài khoản nhận tiền KTX (FR-53). Bỏ trống thì dùng số MẪU — điền tài khoản thật khi triển khai ---
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

# --- Scheduler: bản v2 không còn tác vụ định kỳ (trạng thái hết hạn tính lúc đọc) ---
ENABLE_CRON=false
TZ=Asia/Ho_Chi_Minh

# --- Seed: src/scripts/seed.js XÓA SẠCH CSDL. Chỉ đặt true khi cả nhóm đồng ý seed lại cụm Atlas dùng chung ---
SEED_ALLOW_REMOTE=false
