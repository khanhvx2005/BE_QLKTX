# --- Ứng dụng ---
NODE_ENV=development
PORT=5000

# --- Cơ sở dữ liệu MongoDB ---
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dms_ktx?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/dms_ktx
MONGODB_URI=mongodb://localhost:27017/dms_ktx

# ⚠️ src/scripts/seed.js XÓA SẠCH CSDL. Chỉ đặt true khi cả nhóm thống nhất seed lại cụm Atlas dùng chung
SEED_ALLOW_REMOTE=false

# --- Xác thực JWT & Bảo mật ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- CORS & Địa chỉ Frontend ---
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Tài khoản nhận tiền VietQR động (chuẩn NAPAS 247) & Webhook SePay/Casso ---
VIETQR_BANK_BIN=970436
VIETQR_ACCOUNT_NUMBER=0011001234567
VIETQR_ACCOUNT_NAME=KY TUC XA HAUI
VIETQR_WEBHOOK_SECRET=haui_dms_vietqr_webhook_secret_2026

# --- Cấu hình Email SMTP (Nodemailer) ---
# Nếu bỏ trống SMTP_USER / SMTP_PASS, hệ thống tự động bỏ qua gửi email thật và ghi log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Trung tâm Ký túc xá ĐH Công nghiệp Hà Nội (HaUI - DMS)
